{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The BRICK / BAS browser build. No public URL of its own: robboborben.xyz
  // forwards /demos/brick-bas/* here through the site's BRICK_BAS service
  // binding. Deploy with `npm run deploy`.
  "name": "brick-bas",
  "account_id": "463844ddec7e8872e4609cdac1b86305",
  "compatibility_date": "2026-05-22",
  "main": "./deploy/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/site",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
