[application]
config/name="BAS Sandbox"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_taa.web=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.055, 1)

[layer_names]
3d_physics/layer_1="World collision"
3d_physics/layer_2="Minifigure"
3d_physics/layer_3="Camera-only covers"

[input]
move_forward={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_up={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":69)]}
move_down={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":81)]}
toggle_mode={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":9)]}
cancel_action={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
rotate_piece={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":82)]}
